BOT_TOKEN=
BOT_PREFIX=!
INTENTS_MESSAGE_CONTENT=true
SYNC_COMMANDS=true
DEV_GUILD_ID=
BOT_OWNER_ID=
BOT_OWNER_IDS=
ENV=development

# SparkedHost Apollo database values, or local MySQL values.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
SQL_ECHO=false

# Optional extension filters. The production registry is explicit.
ACTIVE_EXTENSIONS=
INACTIVE_EXTENSIONS=
